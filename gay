<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Justin Rekaj</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Arial, Helvetica, sans-serif;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      overflow: hidden;

      background:
        linear-gradient(135deg, #ff4ecd, #7c4dff, #00d9ff, #65ff8f);
      background-size: 400% 400%;
      animation: backgroundMove 10s ease infinite;
    }

    @keyframes backgroundMove {
      0%   { background-position: 0% 50%; }
      50%  { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    h1 {
      font-size: clamp(45px, 8vw, 100px);
      margin: 0;
      font-weight: 900;
      color: white;
      text-shadow:
        5px 5px 0 #ff1493,
        10px 10px 0 rgba(0,0,0,0.2);
    }

    .letter {
      display: inline-block;
      transition: transform 0.15s ease, color 0.15s ease;
      cursor: default;
    }

    .letter:hover {
      transform: translateY(-20px) rotate(8deg) scale(1.2);
      color: #fff700;
      text-shadow:
        5px 5px 0 #ff1493,
        0 0 25px white;
    }

    .description {
      max-width: 750px;
      margin: 45px 25px 0;
      padding: 25px 30px;
      border-radius: 25px;

      background: rgba(255, 255, 255, 0.9);
      color: #222;
      font-size: 20px;
      line-height: 1.6;

      box-shadow: 0 15px 40px rgba(0,0,0,0.2);
    }

    .skittle {
      position: absolute;
      font-size: 30px;
      animation: float 4s ease-in-out infinite;
      pointer-events: none;
    }

    .s1 { top: 10%; left: 10%; }
    .s2 { top: 20%; right: 12%; animation-delay: 1s; }
    .s3 { bottom: 15%; left: 15%; animation-delay: 2s; }
    .s4 { bottom: 10%; right: 10%; animation-delay: 3s; }

    @keyframes float {
      0%, 100% {
        transform: translateY(0) rotate(0deg);
      }
      50% {
        transform: translateY(-25px) rotate(180deg);
      }
    }
  </style>
</head>

<body>

  <div class="skittle s1">🌈</div>
  <div class="skittle s2">🍬</div>
  <div class="skittle s3">🌈</div>
  <div class="skittle s4">🍬</div>

  <h1 id="title"></h1>

  <div class="description">
    The person I am talking about, <strong>Justin Rekaj</strong>, is gay.
    <br><br>
    He's a little bag of Skittles. Justin's wires happen to be a little twisted.
    Poor Justin. 
  </div>

  <script>
    const text = "Justin Rekaj is Gay";
    const title = document.getElementById("title");

    [...text].forEach(char => {
      const span = document.createElement("span");
      span.className = "letter";
      span.textContent = char === " " ? "\u00A0" : char;
      title.appendChild(span);
    });
  </script>

</body>
</html>
